// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Plan {
  FREE
  BASIC
  PRO
}

enum StatementStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum TransactionType {
  PAYBILL
  TILL
  SEND_MONEY
  RECEIVE_MONEY
  WITHDRAWAL
  DEPOSIT
  AIRTIME
  OTHER
}

enum Category {
  SALES
  SUPPLIER_PAYMENT
  UTILITY
  SALARY
  WITHDRAWAL
  TRANSFER
  AIRTIME
  UNCATEGORIZED
}

enum ReportType {
  MONTHLY_SUMMARY
  KRA_EXPORT
  CASH_FLOW
}

enum SubStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

// User Model
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  businessName  String?
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts     Account[]
  sessions     Session[]
  statements   Statement[]
  reports      Report[]
  subscription Subscription?

  @@map("users")
}

// NextAuth Account Model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session Model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Verification Token (for email verification)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Statement Model
model Statement {
  id          String          @id @default(cuid())
  userId      String
  fileName    String
  fileUrl     String
  status      StatementStatus @default(PENDING)
  periodStart DateTime?
  periodEnd   DateTime?
  totalIn     Float           @default(0)
  totalOut    Float           @default(0)
  netFlow     Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  insight      Insight?
  reports      Report[]

  @@map("statements")
}

// Transaction Model
model Transaction {
  id           String          @id @default(cuid())
  statementId  String
  date         DateTime
  type         TransactionType
  amount       Float
  balance      Float?
  reference    String?
  counterparty String?
  description  String?
  category     Category        @default(UNCATEGORIZED)
  isIncoming   Boolean

  // Relations
  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

// Insight Model
model Insight {
  id             String   @id @default(cuid())
  statementId    String   @unique
  topCustomers   Json
  topExpenses    Json
  peakDays       Json
  monthlySummary Json
  aiSummary      String
  recommendations Json
  healthScore    Int
  createdAt      DateTime @default(now())

  // Relations
  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@map("insights")
}

// Report Model
model Report {
  id          String     @id @default(cuid())
  userId      String
  statementId String
  type        ReportType
  fileUrl     String?
  createdAt   DateTime   @default(now())

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@map("reports")
}

// Subscription Model
model Subscription {
  id                  String    @id @default(cuid())
  userId              String    @unique
  paystackSubId       String?
  plan                Plan
  status              SubStatus @default(ACTIVE)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
